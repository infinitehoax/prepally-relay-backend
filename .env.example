# ─── PrepAlly Relay · Environment Variables ───────────────────────────────────
# Copy this file to .env and fill in your real keys before running.

# ── AI Provider Keys ──────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
HYPERBOLIC_API_KEY=your_hyperbolic_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here

# ── Relay Security ────────────────────────────────────────────────────────────
# The Android client must send this in the X-Relay-Key header on every request.
RELAY_API_KEY=change_this_to_a_strong_random_secret

# ── App Settings ──────────────────────────────────────────────────────────────
APP_NAME=PrepAlly Relay
APP_VERSION=1.0.0
DEBUG=false
